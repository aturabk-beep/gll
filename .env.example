# Server-only variables. Never copy these into mobile/web sources.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_TO_A_UNIQUE_PASSWORD_AT_LEAST_14_CHARACTERS
# Railway: your app's generated HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=https://YOUR-SERVICE.up.railway.app
NODE_ENV=production
PORT=3000
# Railway private-network connection: omit DATABASE_SSL.
# For an external database with a trusted certificate: DATABASE_SSL=verify

# Optional iOS location requests. Leave ALL unset until Apple setup is ready.
# Server only: never put the .p8 key in Git or mobile/web build settings.
# APNS_KEY_ID=YOUR_APPLE_KEY_ID
# APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
# APNS_BUNDLE_ID=tr.com.gulel.gulelPersonnel
# APNS_PRIVATE_KEY=<contents of Apple .p8 file; real newlines or escaped \n>
